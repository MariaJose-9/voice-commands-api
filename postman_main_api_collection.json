{
  "info": {
    "name": "Voice Command API - Main Endpoint",
    "description": "Coleccion minima para probar el endpoint principal: audio de voz a comandos canonicos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://voice-api.mdc-server.com",
      "type": "string"
    },
    {
      "key": "api_token",
      "value": "UU75xrlDeV6up7wyYdOMxhhMsUTP03G6WJaGdh5aQcMOo70p8ykKDLDxOpRy5MjE",
      "type": "string"
    },
    {
      "key": "allowed_audio_extensions",
      "value": ".ogg,.mp3,.m4a,.mp4,.wav,.webm,.aac,.flac",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Voice audio to commands",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{api_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            },
            {
              "key": "language_hint",
              "value": "es",
              "type": "text"
            },
            {
              "key": "context_json",
              "value": "{\"selected_monitor\":null}",
              "type": "text",
              "disabled": true
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/v1/audio/normalize",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "audio",
            "normalize"
          ]
        },
        "description": "Sube un archivo de audio en formato permitido: .ogg, .mp3, .m4a, .mp4, .wav, .webm, .aac o .flac. El API transcribe el audio y devuelve comandos canonicos. Si el decodificador directo falla, el servicio intenta convertir internamente a WAV mono 16 kHz con ffmpeg y reintenta la transcripcion."
      },
      "response": []
    }
  ]
}
