ENV=development
ALLOWED_ORIGINS=*
API_AUTH_TOKEN=
DATABASE_URL=mysql+pymysql://voice_user:voice_password@localhost:3306/voice_command_api?charset=utf8mb4
ADMIN_SESSION_SECRET=change-me-in-production
ADMIN_COOKIE_NAME=voice_admin_session
ADMIN_SESSION_MAX_AGE_SECONDS=86400
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
# Docker/local development defaults favor fast startup.
ENABLE_SEMANTIC_MATCHER=false
ENABLE_OLLAMA_FALLBACK=false
ENABLE_NORMALIZATION_LOGS=true
ENABLE_AUDIO_TRANSCRIPTION=true
ENABLE_AUDIO_TRANSCRIPTION_LOGS=true
FUZZY_THRESHOLD=88
SEMANTIC_THRESHOLD=0.72
SEMANTIC_CONFIRMATION_THRESHOLD=0.62
MAX_TEXT_LENGTH=500
SEMANTIC_TIMEOUT_SECONDS=2.5
SEMANTIC_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_COMMAND_MODE=fallback
OLLAMA_TIMEOUT_SECONDS=8
LLM_ACCEPT_THRESHOLD=0.78
LLM_CONFIDENCE_CAP=0.90
LLM_USE_FULL_TEXT_ON_INCOMPLETE=true
LLM_USE_PREVIOUS_COMMANDS=true
DEBUG_LLM_PROMPT=false
ALLOW_DYNAMIC_SIZE_INCHES=true
MIN_SIZE_INCHES=40
MAX_SIZE_INCHES=150
ALLOWED_SIZE_INCHES=55,65,75,95,120
TRANSCRIPTION_ENGINE=faster_whisper
TRANSCRIPTION_MODEL_NAME=tiny
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8
TRANSCRIPTION_BEAM_SIZE=1
TRANSCRIPTION_VAD_FILTER=false
TRANSCRIPTION_LANGUAGE_DEFAULT=
MAX_AUDIO_FILE_MB=10
MAX_AUDIO_DURATION_SECONDS=30
ALLOWED_AUDIO_EXTENSIONS=.ogg,.mp3,.m4a,.mp4,.wav,.webm,.aac,.flac
ALLOWED_AUDIO_MIME_TYPES=audio/ogg,application/ogg,audio/mpeg,audio/mp3,audio/mp4,audio/x-m4a,audio/m4a,audio/wav,audio/wave,audio/x-wav,audio/vnd.wave,audio/webm,audio/aac,audio/x-aac,audio/flac,audio/x-flac,video/mp4,video/webm,application/octet-stream
AUDIO_TEMP_DIR=/tmp/voice-command-audio
AUDIO_MODEL_WARMUP_ON_STARTUP=false

# Recommended real doctor testing profile:
# ENABLE_SEMANTIC_MATCHER=true
# TRANSCRIPTION_MODEL_NAME=base
# TRANSCRIPTION_COMPUTE_TYPE=int8
# FUZZY_THRESHOLD=86
# SEMANTIC_THRESHOLD=0.72
# SEMANTIC_CONFIRMATION_THRESHOLD=0.62
# MAX_AUDIO_DURATION_SECONDS=30
# If the machine has enough CPU/RAM, try:
# TRANSCRIPTION_MODEL_NAME=small
